pipeline {
    agent none

    stages {

        stage('Test, Coverage, SonarQube') {
            agent {
                docker {
                    image 'maven:3.9.16-eclipse-temurin-21'
                }
            }

            environment {
                MAVEN_OPTS = "-Dmaven.repo.local=${WORKSPACE}/.m2"
            }

            stages {
                stage('Test') {
                    steps {
                        sh 'mvn test -B -ntp'
                        sh '''
                          echo "=== Surefire reports ==="
                          find target -type f -name "*.xml" -print || true
                        '''
                    }

                    post {
                        always {
                            junit(
                                testResults: 'target/surefire-reports/*.xml',
                                allowEmptyResults: true
                            )
                        }
                    }
                }

                stage('Coverage') {
                    steps {
                        sh 'mvn jacoco:report -B -ntp'
                        sh 'echo "=== JaCoCo report ==="'
                        sh 'find target/site/jacoco -type f -print || true'
                    }

                    post {
                        success {
                            recordCoverage(
                                tools: [[
                                    parser: 'JACOCO',
                                    pattern: 'target/site/jacoco/jacoco.xml'
                                ]]
                            )
                        }
                    }
                }

                stage('SonarQube') {
                    steps {
                        echo "========== SONARQUBE =========="

                        withSonarQubeEnv('sonarqube') {//nombre del sonarqube configurado en el entorno system de jenkins
                            //sh "mvn org.sonarsource.scanner.maven:sonar-maven-plugin:sonar -B -ntp -Dsonar.branch.name=master -Dsonar.branch.target=main"
                            sh "mvn org.sonarsource.scanner.maven:sonar-maven-plugin:sonar -B -ntp"
                        }
                    }
                }
            }
        }

        stage('DockerHub') {
            agent {
                docker {
                    image 'docker:29.8.0-cli'
                    args '-u root:root -v /var/run/docker.sock:/var/run/docker.sock'
                }
            }

            environment {
                DOCKER_CONFIG = "${WORKSPACE}/.docker"
                DOCKERHUB_CREDENTIALS = credentials('dockerhub-credentials')
            }

            steps {
                sh 'docker --version'

                script {
                    def pom = readMavenPom file: 'pom.xml'
                    def image = "marcozavaletab/${pom.artifactId}"
                    def tag = "v${env.BUILD_NUMBER}"

                    sh "docker build -t ${image}:${pom.version}  -t ${image}:${tag}  -t ${image}:latest ."
                     
                    sh 'echo "$DOCKERHUB_CREDENTIALS_PSW" | docker login -u "$DOCKERHUB_CREDENTIALS_USR" --password-stdin'

                    sh "docker push ${image}:${pom.version}"
                    sh "docker push ${image}:${tag}"
                    sh "docker push ${image}:latest"

                    sh 'docker logout'
                }
            }
        }
    }
}